__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
data/
shards/
model_cache/
*.zip
*.mp4
.venv_scoring/

# Generated by scripts/build_cases_txt.py; machine-specific staging paths.
condor/cases.txt
condor/cases_test.txt
condor/extract_test.sub
logs/

# Container images live in /staging, never in git. HTCondor's
# when_to_transfer_output = ON_EXIT copies build outputs back into the submit
# directory (containers/ here), so a stray multi-GB .sif can land in the repo
# root after a build job runs — never commit it.
*.sif

# HTCondor transfer_output_files drops the validation harness's reports into
# the repo ROOT (condor/validate_*.sub). The copies worth keeping are curated
# into outputs/ by hand; the raw landing spot is not.
/*_candidates.json
/*_results.json
# `/*_candidates.json` requires the underscore, so the bare filename that
# condor/validate_*.sub also drops here escaped it. Named explicitly rather
# than loosening the glob, so the curated copies under outputs/ stay tracked.
/candidates.json
# Job outputs land in the submit directory, which is the repo root. These are
# condor/vlm_eval.sub's; they belong under outputs/, not here.
/vlm_fallback_pairs.json
/vlm_offon_diff.json
/validate_work/
/context/

# Build context tarball: staged to /staging by containers/build_submission.sh.
# A copy landed in the repo root once and helped exhaust a quota; never track it.
submission_context.tar.gz
*.sif

# Preventive, not remedial: nothing of these types is tracked today and none
# should ever be. Checkpoints live in /staging and are copied into the build
# context by containers/build_submission.sh, never committed; .env is here so
# a future secret cannot be added by a careless `git add .`.
*.pt
*.ckpt
*.safetensors
.env

# Ad-hoc audit scratch: the §3.4 corpus-scan harness (docs/compliance_audit.md)
# and its case lists. Kept on disk, deliberately not tracked. Delete this rule
# if the harness is ever worth keeping in the repository.
/audit/
condor/generated/

# DAGMan REGENERATES all of these from the .dag every run -- .condor.sub,
# .dagman.log/.out, .lib.err/.out, .nodes.log, .lock, .metrics, .rescueNNN.
# Seven of them were tracked, so every DAG run dirtied the working tree and
# every diff carried job logs nobody reads. The .dag SOURCES stay tracked;
# only what DAGMan writes from them is ignored.
condor/*.dag.condor.sub
condor/*.dag.dagman.*
condor/*.dag.lib.*
condor/*.dag.nodes.log
condor/*.dag.lock
condor/*.dag.metrics
condor/*.dag.rescue*

# Job outputs land in the SUBMIT directory, which is the repo root: every
# transfer_output_files JSON from verify.sub, train_temporal.sub and the
# validators. The rules above already named a few families one at a time and
# kept missing new ones (tests_*, verify_*, fuse_*, init_*, ctl_*, task*), so
# this ignores root-level JSON as a class. Results worth keeping are curated
# into outputs/ BY HAND -- which is where motion_calibration.json and
# cache_vs_dump.json now live, having been committed to the root by accident.
# Nested JSON (config/, outputs/, tests/) is untouched.
/*.json

# Validation and probe RUN ARTIFACTS, not source. condor/validate_image.sh and
# condor/probe_t4_memory.sh write these into the submit directory when run
# from an interactive shell rather than a Condor scratch dir, and a `git add
# -A` after a validation run sweeps them in. They are per-run measurements
# whose values are already quoted, with job numbers, in the code comments.
image_answers.tsv
image_vlm.tsv
image_validation.json
image_validation.err
results.jsonl
caseerr/
t4simdir/
