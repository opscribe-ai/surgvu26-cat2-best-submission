# Any CPU-only measurement that needs the OFFICIAL metric (roberta-large).
#
#   condor_submit condor/metric.sub \
#       script=scripts/count_form_eval.py out=count_form_results.json
#
# `script`, `out` and `args` are submit-time macros rather than baked in, so
# this one file drives every metric study instead of growing another
# near-identical .sub per experiment -- which is how condor/hedge.sh came to
# carry a copy of a bug that had already been fixed elsewhere.
#
# universe=vanilla, not container: condor/metric.sh runs `apptainer exec` on
# the extract .sif, which cannot be nested inside a container-universe job.

universe   = vanilla
executable = condor/metric.sh
arguments  = "$(script) $(out) $(args)"

+WantStagingMount = true

# `extra` carries anything a particular study needs beyond the code -- e.g.
#   condor_submit condor/metric.sub script=... extra=outputs/serving_thresholds.json
#   condor_submit condor/metric.sub script=... extra=config
# It defaults to src so the list is never empty: HTCondor rejects a trailing
# comma, and repeating src is harmless.
#
# NOTE THAT config/ IS NOT TRANSFERRED BY DEFAULT. Anything reading
# config/descriptions.yaml or config/splits_v2.json must pass `extra=config`;
# cluster 9653913 died two seconds in without it. A DIRECTORY arrives intact,
# a FILE arrives flattened into the scratch root -- which is why
# scripts/list_policy_eval.py resolves its thresholds path against both
# layouts instead of trusting one.
transfer_input_files = src, scripts, $(extra:src)

request_cpus   = 4
request_memory = 16GB
request_disk   = 8GB

output = logs/metric_$(Cluster).out
error  = logs/metric_$(Cluster).err
log    = logs/metric_$(Cluster).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Only the results file. Left unset, ON_EXIT drags back the __pycache__ trees
# Python writes into the transferred src/ and scripts/.
transfer_output_files   = $(out)

max_retries = 2

queue 1
