# The 11 public sample cases through the real serving path, with motion and
# without, diffed. See condor/motion_ab.sh.
#
#   condor_submit condor/motion_ab.sub

universe        = container
container_image = file:///staging/n/nkalthoff/surgvu26/surgvu26-train.sif

executable   = condor/motion_ab.sh
arguments    = "$(device:auto)"

+WantStagingMount = true
transfer_input_files = src, scripts, config

request_cpus   = $(cpus:4)
request_memory = $(memory:16GB)
request_disk   = $(disk:16GB)
request_gpus   = $(gpus:1)
require_gpus   = (GlobalMemoryMb >= $(gpumem:10000))

output = logs/motionab_$(Cluster).out
error  = logs/motionab_$(Cluster).err
log    = logs/motionab_$(Cluster).log

stream_output = True
stream_error  = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = motion_ab.json, motion_off_candidates.json, motion_on_candidates.json

retry_until = (ExitCode =?= 0 || ExitCode =?= 1)
max_retries = 5

queue 1
