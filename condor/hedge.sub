# Should the router hedge between two instrument names when the model is
# unsure? Combines a measured accuracy-vs-margin curve with measured
# official-metric scores for each answer form. See scripts/hedge_tradeoff.py.
#
#   condor_submit condor/hedge.sub
#
# universe=vanilla, not container: condor/hedge.sh runs `apptainer exec` on the
# extract .sif, which cannot be nested inside a container-universe job.

universe   = vanilla
executable = condor/hedge.sh
arguments  = "hedge_results.json"

+WantStagingMount = true

transfer_input_files = src, scripts

request_cpus   = 4
request_memory = 16GB
request_disk   = 8GB

output = logs/hedge_$(Cluster).out
error  = logs/hedge_$(Cluster).err
log    = logs/hedge_$(Cluster).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Only the results file. Left unset, ON_EXIT drags back the __pycache__ trees
# Python writes into the transferred src/ and scripts/.
transfer_output_files   = hedge_results.json

max_retries = 2

queue 1
