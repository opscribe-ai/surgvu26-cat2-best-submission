# Pack the Grand Challenge MODEL TARBALL (int8 VLM + judge) on a compute node.
#
#   condor_submit condor/make_sidecar.sub
#
# NOT on the login node: this tars and gzips ~11.5 GB, and heavy work on
# ap2001 wedges the session for everyone. Same reason container builds run
# here.
# BOTH the source tree and the output path are submit macros as of 2026-08-29.
# Before that, neither could be typed: SIDECAR_DIR fell to the script's default
# (models_sidecar, holding the v5 int8 VLM) and the output to its default
# (surgvu26-models.tar.gz, v5.2's uploaded artifact). Packing v6 would then have
# silently OVERWRITTEN the v5.2 model tarball with v5.2's own contents renamed
# -- or, worse, published v5 weights under a v6 name. Both artifacts are kept
# side by side instead, so v5.2 stays reproducible.
#
#   condor_submit condor/make_sidecar.sub \
#       work=/staging/n/nkalthoff/surgvu26/models_sidecar_v6 \
#       out=/staging/n/nkalthoff/surgvu26/surgvu26-models-v6.tar.gz
#
# The DIRECTORY NAMES INSIDE `work` are load-bearing, not cosmetic:
# scripts/inference.py's `resolve_vlm_model_dir` looks for
# /opt/ml/model/qwen25vl-7b-int8 FIRST, then .../qwen25vl-7b-nf4. A v6 model in
# a folder named anything else is invisible, and a leftover v5
# `qwen25vl-7b-int8` in the same tarball outranks it.
# `if ! defined`, not `$(name:default)`. Two reasons, both learned here:
#   * `$(out:...)` does NOT expand inside a quoted `arguments` string -- it was
#     passed through literally as the filename. `environment` expanded the same
#     syntax fine, which is exactly the kind of half-working thing that ships.
#   * A bare `out = ...` default would be worse than useless: condor_submit
#     applies command-line macros BEFORE parsing the file, so the file's own
#     assignment would silently overwrite what was typed on the command line.
#     That is the trap that made a torch-2.6 smoke test run on torch 2.5.1
#     (job 9713236) and it is guarded the same way here.
if ! defined out
  out = /staging/n/nkalthoff/surgvu26/surgvu26-models.tar.gz
endif
if ! defined work
  work = /staging/n/nkalthoff/surgvu26/models_sidecar
endif

universe   = vanilla
executable = scripts/make_model_sidecar.sh
arguments  = "$(out)"
environment = "SIDECAR_DIR=$(work)"

+WantStagingMount = true
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    =
transfer_output_files   =

request_cpus   = 4
request_memory = 8GB
# 4GB, not 20: nothing is copied locally any more. The tree is packed straight
# from /staging into a tarball also on /staging, so this is headroom for tar's
# buffering rather than for the data.
request_disk   = 4GB

output = logs/sidecar_$(Cluster).out
error  = logs/sidecar_$(Cluster).err
log    = logs/sidecar_$(Cluster).log
stream_output = True
stream_error  = True

max_retries = 2
queue 1
